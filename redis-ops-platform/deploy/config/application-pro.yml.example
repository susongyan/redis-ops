# 复制到 /etc/redis-ops-platform/application-pro.yml；替换全部 REPLACE_*。
# 不直接部署仓库内示例账号；不要将填入真实秘密的文件提交 Git。
spring:
  application:
    name: redis-ops-platform
  datasource:
    url: "jdbc:mysql://REPLACE_MYSQL_HOST:3306/redis_governance?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC"
    username: redis_ops_platform
    password: "REPLACE_PLATFORM_PASSWORD"
  flyway:
    enabled: true
    # 独立迁移账号；url 默认沿用 datasource。schema 只由 Platform 迁移。
    user: redis_ops_migrator
    password: "REPLACE_MIGRATOR_PASSWORD"
identity:
  bootstrap:
    username: admin
    # 首次初始化前设置强随机密码；初始化并改密后删除本项。重启不覆盖账户。
    password: "REPLACE_INITIAL_ADMIN_PASSWORD"
  cookie-secure: true
server:
  port: 8080
management:
  endpoints:
    web:
      exposure:
        include: health,info,prometheus
  endpoint:
    health:
      show-details: never
platform:
  jobs:
    enabled: true
    instance-id: platform-pro-01
    discovery:
      poll-interval-ms: 1000
    risk-scan:
      poll-interval-ms: 1000
    validation:
      poll-interval-ms: 1000
    ttl-governance:
      poll-interval-ms: 1000
    cleanup-governance:
      poll-interval-ms: 1000
collector:
  enabled: true
  fast-interval-ms: 15000
  page-size: 200
redis-ops:
  analysis:
    http:
      endpoint: ""
      timeout-ms: 5000
    acp:
      endpoint: ""
      timeout-ms: 10000
  credential:
    keys: "v1:REPLACE_BASE64_32_BYTE_KEY"
    rotation-batch-size: 50
