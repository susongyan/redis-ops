<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="redis-ops-platform"/>
    <springProperty scope="context" name="LOG_DIRECTORY" source="log-dir" defaultValue="${LOG_DIR:-./log}"/>
    <property name="CONSOLE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSSXXX} %5p [${APP_NAME}] [pid=${PID:-}] [%t] %logger{48} - %msg%n%wEx"/>
    <property name="FILE_LOG_PATTERN" value="${CONSOLE_LOG_PATTERN}"/>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <property name="DAILY_PATTERN" value="${LOG_DIRECTORY}/%d{yyyy-MM-dd}/platform.%i.log"/>
    <property name="MAX_FILE_SIZE" value="20MB"/>
    <property name="MAX_HISTORY" value="14"/>
    <property name="TOTAL_SIZE_CAP" value="1GB"/>
    <property name="CLEAN_HISTORY" value="true"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <appender name="DAILY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- No fixed file: the active file itself follows the rolling date directory. -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${DAILY_PATTERN}</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>${CLEAN_HISTORY}</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${FILE_LOG_CHARSET}</charset>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="DAILY_FILE"/>
    </root>
</configuration>
