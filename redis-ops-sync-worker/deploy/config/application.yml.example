# 复制到部署工作目录的 config/application.yml（相对 java 进程启动目录解析；
# opsctl 部署即 <INSTALL_DIR>/config/）。用于不接 Apollo 的部署；接 Apollo 时
# 同名键会被 Apollo 发布值覆盖（优先级见 docs/apollo-integration.md）。
# 替换全部 REPLACE_*。
spring:
  application:
    name: redis-ops-sync-worker
  datasource:
    url: "jdbc:mysql://REPLACE_MYSQL_HOST:3306/redis_governance?useUnicode=true&characterEncoding=utf8"
    username: redis_ops_worker
    password: "REPLACE_WORKER_PASSWORD"
  flyway:
    enabled: false
server:
  port: 8081
management:
  endpoints:
    web:
      exposure:
        include: health,info,prometheus
  endpoint:
    health:
      show-details: never
redis-ops:
  credential:
    # 必须与 Platform 密钥环一致。
    keys: "v1:REPLACE_BASE64_32_BYTE_KEY"
sync:
  engine:
    enabled: true
    instance-id: worker-pro-01
    worker-ip: "" # Automatically detect IP address; set the deployment machine IP when containerized.
    data-dir: /var/lib/redis-ops-worker/spool
    max-concurrent-tasks: 2
    poll-interval-ms: 500
    lease-seconds: 30
    lease-renew-interval-ms: 5000
    lease-safety-margin-ms: 2000
    recovery-scan-interval-ms: 2000
    metric-interval-ms: 1000
    segment-bytes: 268435456
    fsync-interval-ms: 200
    connect-timeout-ms: 10000
    full-apply-concurrency: 4
    full-apply-queue-capacity: 2000
    full-apply-pipeline-size: 100
    full-apply-transaction-max-bytes: 4194304
