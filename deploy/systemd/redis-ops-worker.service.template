[Unit]
Description=Redis Governance Sync Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@DEPLOY_USER@@
Group=@@DEPLOY_GROUP@@
WorkingDirectory=@@INSTALL_DIR@@
EnvironmentFile=@@INSTALL_DIR@@/conf/redis-ops.env
ExecStart=@@INSTALL_DIR@@/bin/redis-opsctl run worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
