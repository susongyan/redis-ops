pid @@INSTALL_DIR@@/var/run/frontend.pid;
error_log @@INSTALL_DIR@@/var/log/frontend-error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log @@INSTALL_DIR@@/var/log/frontend-access.log;
    sendfile on;
    keepalive_timeout 65;

    client_body_temp_path @@INSTALL_DIR@@/var/nginx/client_body;
    proxy_temp_path @@INSTALL_DIR@@/var/nginx/proxy;
    fastcgi_temp_path @@INSTALL_DIR@@/var/nginx/fastcgi;
    uwsgi_temp_path @@INSTALL_DIR@@/var/nginx/uwsgi;
    scgi_temp_path @@INSTALL_DIR@@/var/nginx/scgi;

    server {
        listen @@FRONTEND_BIND@@:@@FRONTEND_PORT@@;
        server_name _;
        root @@INSTALL_DIR@@/frontend;
        index index.html;

        location /api/ {
            proxy_pass @@PLATFORM_PROXY_URL@@;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
