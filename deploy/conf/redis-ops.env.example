# Copy this file to redis-ops.env, edit it, then run: chmod 600 redis-ops.env
# Use shell-compatible KEY=value syntax. Do not commit the resulting file.

# Shared MySQL location. Keep URL quoted because JDBC query strings contain '&'.
DB_URL='jdbc:mysql://mysql.example.internal:3306/redis_governance?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC'

# Platform account: schema migration and platform tables.
DB_USERNAME='redis_ops_platform'
DB_PASSWORD='CHANGE_ME'

# Sync Worker account: assets/secrets read-only; sync runtime tables read-write.
SYNC_DB_USERNAME='redis_ops_sync'
SYNC_DB_PASSWORD='CHANGE_ME'

# AES credential key ring. The first key encrypts new data; all keys may decrypt.
# Generate once with: openssl rand -base64 32
# Keep the same value on Platform and every Sync Worker.
REDIS_OPS_CREDENTIAL_KEYS='v1:CHANGE_ME_BASE64_32_BYTE_KEY'

# Service ports and frontend reverse-proxy target.
PLATFORM_PORT=8080
SYNC_SERVICE_PORT=8081
FRONTEND_PORT=8088
FRONTEND_BIND='0.0.0.0'
PLATFORM_PROXY_URL='http://127.0.0.1:8080'

# Process settings.
PLATFORM_JAVA_OPTS='-Xms512m -Xmx1024m -XX:+ExitOnOutOfMemoryError'
SYNC_WORKER_JAVA_OPTS='-Xms1g -Xmx2g -XX:+ExitOnOutOfMemoryError'
STARTUP_TIMEOUT_SECONDS=90
STOP_TIMEOUT_SECONDS=30
LOG_DIR=

# Platform built-in discovery worker. This is separate from the Sync Worker.
WORKER_ENABLED=true
DISCOVERY_POLL_INTERVAL_MS=1000

# Sync Worker identity, lease, concurrency, and local encrypted spool.
SYNC_ENGINE_ENABLED=true
SYNC_ENGINE_INSTANCE_ID='CHANGE_ME_HOSTNAME-sync-1'
SYNC_ENGINE_DATA_DIR=
SYNC_ENGINE_MAX_CONCURRENT_TASKS=2
SYNC_ENGINE_POLL_INTERVAL_MS=500
SYNC_ENGINE_LEASE_SECONDS=30
SYNC_ENGINE_LEASE_RENEW_INTERVAL_MS=5000
SYNC_ENGINE_LEASE_SAFETY_MARGIN_MS=2000
SYNC_ENGINE_RECOVERY_SCAN_INTERVAL_MS=2000
SYNC_ENGINE_METRIC_INTERVAL_MS=1000
SYNC_ENGINE_SEGMENT_BYTES=268435456
SYNC_ENGINE_FSYNC_INTERVAL_MS=200
SYNC_ENGINE_CONNECT_TIMEOUT_MS=10000
SYNC_ENGINE_FULL_APPLY_CONCURRENCY=4
SYNC_ENGINE_FULL_APPLY_QUEUE_CAPACITY=2000
SYNC_ENGINE_FULL_APPLY_PIPELINE_SIZE=100
SYNC_ENGINE_FULL_APPLY_TRANSACTION_MAX_BYTES=4194304
SYNC_FLYWAY_ENABLED=false

# Used when rendering systemd units.
DEPLOY_USER='redisops'
DEPLOY_GROUP='redisops'
